?prog: _BEGIN stm _END -> program

?stm: base_stm
    | stm ";" base_stm -> sequential_execution

?base_stm: VAR ":=" aexp -> assignment
         | _IF bexp _THEN base_stm _ELSE base_stm -> if_statement
         | _WHILE bexp _DO base_stm -> while_cycle
         | _BEGIN stm _END -> block
         | _SKIP -> skip

?aexp: aexp "+" term -> add
     | aexp "-" term -> sub
     | term

?term: term "*" factor -> mult
     | factor

?factor: NUMBER -> number
       | VAR -> variable
       | "(" aexp ")" -> paren_expr

?bexp: or_bexp

?or_bexp: or_bexp _OR not_bexp -> logic_or
        | not_bexp

?not_bexp: _NOT not_bexp -> logic_not
         | comp_bexp

?comp_bexp: aexp "=" aexp -> eq
          | aexp ">" aexp -> gr
          | "(" bexp ")" -> paren_cond

_BEGIN: /\bbegin\b/
_END: /\bend\b/
_IF: /\bif\b/
_THEN: /\bthen\b/
_ELSE: /\belse\b/
_WHILE: /\bwhile\b/
_DO: /\bdo\b/
_SKIP: /\bskip\b/
_OR: /\bor\b/
_NOT: /\bnot\b/

NUMBER: /-?[0-9]+/
VAR.1: /(?!\b(?:begin|end|if|then|else|while|do|skip|or|not)\b)[A-Za-z_][A-Za-z0-9_]*/

%import common.WS
%ignore WS